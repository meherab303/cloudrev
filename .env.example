# Application
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# PostgreSQL
DATABASE_URL=postgresql://cloudreve:cloudreve@postgres:5432/cloudreve?schema=public
POSTGRES_USER=cloudreve
POSTGRES_PASSWORD=cloudreve
POSTGRES_DB=cloudreve

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cloudreve
MINIO_REGION=us-east-1

# Storage
MAX_FILE_SIZE_BYTES=2147483648
DEFAULT_QUOTA_BYTES=5368709120

# Admin seed
ADMIN_EMAIL=admin@cloudreve.local
ADMIN_PASSWORD=Admin123!
